# Herdr Gotify Notifications — configuration.
#
# Copy this file to the plugin config directory printed by:
#
#     herdr plugin config-dir 8liang.herdr-gotify
#
# e.g. ~/.config/herdr/plugins/config/8liang.herdr-gotify/config.env
# (macOS: ~/Library/Application Support/herdr/plugins/config/8liang.herdr-gotify/config.env)
#
# Or, while developing a local checkout, to ./config.env next to notify.sh.
# Every line below is the default, so this file as written changes nothing.
# A variable exported in the environment overrides what is written here.

# Gotify server and application token (required for push).
GOTIFY_URL="https://gotify.example.com"
GOTIFY_TOKEN="CHANGE_ME"

# Push priority for each event type (Gotify: 0 min … 10 max).
GOTIFY_PRIORITY_BLOCKED=8
GOTIFY_PRIORITY_DONE=5

# Turn a status off entirely by setting it to false.
NOTIFY_BLOCKED=true
NOTIFY_DONE=true

# Also raise a local Herdr desktop notification before the Gotify push.
GOTIFY_ALSO_HERDR_NOTIFY=false
